# IG demo account for paper trading (create one at ig.com; demo only, never a live account).
# The API key is under My IG > Settings > API keys (generate it while logged in to the demo account).
# IG_API_KEY=
# IG_USERNAME=
# IG_PASSWORD=
# IG_ACCOUNT_ID=             # optional: which demo account to use if you have several
